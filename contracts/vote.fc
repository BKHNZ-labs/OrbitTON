#include "imports/stdlib.fc";
#include "common/messages.fc";
#include "common/address.fc";
#include "common/utils.fc";
#include "proposal/utils.fc";
#include "op-codes.fc";

global slice proposal_address;
global slice vote_owner;
global int vote_status;

() load_data() impure {
    var ds = get_data().begin_parse();
    vote_status = ds~load_int(2);
    proposal_address = ds~load_msg_addr();
    vote_owner = ds~load_msg_addr();
    ds.end_parse();
}

;; save_data stores storage variables as a cell into persistent storage
() save_data() impure inline_ref {
    set_data(
        begin_cell()
          .store_int(vote_status, 2)
          .store_slice(proposal_address)
          .store_slice(vote_owner)
        .end_cell()
    );
}

int calculate_vote_power(int vote_status, int vote_power) {
  if (vote_power == 1) {
    if (vote_status == 0) {
      return -1;
    } else {
      return 0;
    }
  }

  if (vote_power == 0) {
    if (vote_status == 0) {
      return 0;
    } else {
      return 1;
    }
  }

  return 0;
}

  
() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) { ;; ignore all empty messages        
    return ();
  }

  slice cs = in_msg_full.begin_parse();
  
  int flags = cs~load_uint(4);

  if (flags & 1) { ;; ignore all bounced messages
      return ();
  }

  load_data(); ;; here we populate the storage variables

  slice sender_address = cs~load_msg_addr();
  int op = in_msg_body~load_uint(32); ;; by convention, the first 32 bits of incoming message is the op
  int query_id = in_msg_body~load_uint(64); ;; also by convention, the next 64 bits contain the "query id", although this is not always the case

  if (op == op::init_vote) {
    throw_unless(401, compare_address(sender_address, proposal_address));
    ;; if vote status is -1 and not setted before, vote_power = 1
    ;; if vote status is -1 and setted before, vote_power = 0
    ;; if vote status is 0, vote_power = 0
    int vote_power = vote_status == -1 ? 1 : 0;
    vote_status = in_msg_body~load_int(2);
    vote_power = calculate_vote_power(vote_status, vote_power);
    cell msg = begin_cell()
      .store_uint(op::cb_vote, 32)
      .store_uint(query_id, 64)
      .store_int(vote_power, 2)
      .store_slice(vote_owner)
      .end_cell();
    send_simple_message(0, proposal_address, msg, CARRY_REMAINING_GAS);
    save_data();
    return ();
  }
}

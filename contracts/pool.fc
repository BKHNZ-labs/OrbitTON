slice get_calculate_position_address(int tick_lower, int tick_upper, slice owner) method_id {
  load_data();
  (_, slice position_address) = get_position_state_init_and_address(tick_lower, tick_upper, owner, my_address(), storage::position_code);
  return position_address;
}

(int, int, int, int, int) get_pool_info() method_id {
  load_data();
  return (storage::fee, storage::tick_spacing, storage::tick, storage::sqrt_price_x96, storage::liquidity);
}

(int, int) get_fee_growth_global() method_id {
  load_data();
  return (storage::fee_growth_global_0x128, storage::fee_growth_global_1x128);
}

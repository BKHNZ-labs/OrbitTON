;; recv_internal is the main function of the contract and is called when it receives a message from other contracts
() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure { 
  if (in_msg_body.slice_empty?()) { ;; ignore all empty messages        
    return ();
  }

  slice cs = in_msg_full.begin_parse();
   
  int flags = cs~load_uint(4);

  if (flags & 1) { ;; ignore all bounced messages
    return ();
  }
  load_data(); ;; here we populate the storage variables

  slice sender_address = cs~load_msg_addr();
  int op = in_msg_body~load_uint(32); ;; by convention, the first 32 bits of incoming message is the op
  int query_id = in_msg_body~load_uint(64); ;; also by convention, the next 64 bits contain the "query id", although this is not always the case
  
  if (op == op::initialize) {
    throw_unless(error::unauthorized, compare_address(sender_address, storage::router_address));
    (int relative_sqrt_price_x96, slice response_address) = (in_msg_body~load_uint(160), in_msg_body~load_msg_addr());
    ;; make sure it is first time
    if ((storage::tick == 0) & (storage::sqrt_price_x96 == 0) & (storage::max_liquidity_per_tick == 0)) {
      int relative_tick = tick_math::get_tick_at_sqrt_ratio(relative_sqrt_price_x96);
      storage::tick = relative_tick;
      storage::sqrt_price_x96 = relative_sqrt_price_x96;
      storage::max_liquidity_per_tick = tick::tick_spacing_to_max_liquidity_per_tick(storage::tick_spacing);
      builder body = begin_cell()
            .store_uint(op::cb_create_pool, 32)
            .store_uint(query_id, 64)
            .store_slice(storage::jetton0_wallet) ;; jetton 1
            .store_slice(storage::jetton1_wallet) ;; jetton 0
            .store_uint(storage::fee, 24)
            .store_int(storage::tick_spacing, 24)
            .store_slice(response_address);
      send_simple_message(0, storage::router_address, body.end_cell(), CARRY_REMAINING_GAS);
      save_data();
    }
    return ();
  }

  if(op == op::mint){
    throw_unless(error::unauthorized, compare_address(sender_address, storage::router_address));
    slice body = in_msg_body~load_ref().begin_parse();
    (int jetton_amount_0, int jetton_amount_1,  int tick_lower, int tick_upper, int liquidity_delta, slice recipient) = (body~load_coins(), body~load_coins(), body~load_int(24), body~load_int(24), body~load_int(128),  body~load_msg_addr());
    cell state_init = calculate_lp_account_state_init(recipient, my_address(), tick_lower, tick_upper, storage::lp_account_code);
    slice to_lp_account_address = calculate_lp_account_address(state_init);
    builder body = begin_cell()
            .store_uint(op::add_liquidity, 32)
            .store_uint(query_id, 64)
            .store_coins(jetton_amount_0)
            .store_coins(jetton_amount_1)
            .store_int(liquidity_delta, 128);
    send_message_with_stateinit(0, to_lp_account_address, state_init, body.end_cell(), CARRY_REMAINING_GAS);
    save_data();
    return ();
  }

  if(op == op::cb_add_liquidity){
    slice body = in_msg_body~load_ref().begin_parse();
    (int jetton_0_amount, int jetton_1_amount, int tick_lower, int tick_upper, int liquidity_delta, slice recipient) = (body~load_coins(), body~load_coins(), body~load_int(24), body~load_int(24), body~load_int(128), body~load_msg_addr());
    slice lp_account = calculate_user_lp_account_address(recipient, my_address(), tick_lower,tick_upper,storage::lp_account_code);
    throw_unless(error::unauthorized, compare_address(sender_address, lp_account));
    ;; _updatePosition
    int flipped_lower = 0;
    int flipped_upper = 0;
    if(liquidity_delta != 0){
      flipped_lower = storage::ticks~tick::update(
        tick_lower,
        storage::tick,
        liquidity_delta,
        storage::fee_growth_global_0x128,
        storage::fee_growth_global_1x128,
        0,
        storage::max_liquidity_per_tick
      );

      flipped_upper = storage::ticks~tick::update(
        tick_upper,
        storage::tick,
        liquidity_delta,
        storage::fee_growth_global_0x128,
        storage::fee_growth_global_1x128,
        -1,
        storage::max_liquidity_per_tick
      );
    }

    if (liquidity_delta < 0){
      if(flipped_lower){
        storage::ticks~tick::clear(tick_lower);
      }
      if(flipped_upper){
        storage::ticks~tick::clear(tick_upper);
      }
    }
    (int fee_growth_inside_0X128, int fee_growth_inside_1X128) = storage::ticks.tick::get_fee_growth_inside(tick_lower,tick_upper, storage::tick, storage::fee_growth_global_0x128,storage::fee_growth_global_1x128);
    int amount0 = 0;
    int amount1 = 0;
    if(storage::tick < tick_lower){
      amount0 = sqrt_price_math::get_amount0_delta_special(tick_math::get_sqrt_ratio_at_tick(tick_lower), tick_math::get_sqrt_ratio_at_tick(tick_upper), liquidity_delta);
    } elseif (storage::tick < tick_upper) {
      amount0 = sqrt_price_math::get_amount0_delta_special(storage::sqrt_price_x96, tick_math::get_sqrt_ratio_at_tick(tick_upper), liquidity_delta);
      amount1 = sqrt_price_math::get_amount1_delta_special(
        tick_math::get_sqrt_ratio_at_tick(tick_lower),
        storage::sqrt_price_x96,
        liquidity_delta
      );
      storage::liquidity = storage::liquidity.liquidity_math::add_delta(liquidity_delta);
    } elseif (tick_upper < storage::tick){
      amount1 = sqrt_price_math::get_amount1_delta_special(tick_math::get_sqrt_ratio_at_tick(tick_lower), tick_math::get_sqrt_ratio_at_tick(tick_upper), liquidity_delta);
    }

    if((amount0 > jetton_0_amount) | (amount1 > jetton_1_amount)){
      ;; refunds to user
      builder low_amount_body = build_pay_to_msg(query_id, recipient, error::LOW_AMOUNT, storage::jetton0_wallet, jetton_0_amount, storage::jetton1_wallet, jetton_1_amount, storage::fee, storage::tick_spacing); 
      send_simple_message(0, storage::router_address, low_amount_body.end_cell(), CARRY_REMAINING_GAS);
      return ();
    } 
  
    int refund_amount0 = jetton_0_amount - amount0;
    int refund_amount1 = jetton_1_amount - amount1;
    int remaining_gas = msg_value;
    if((refund_amount0 > 0) | (refund_amount1 > 0)){
      ;; refunds to user
      builder refund_body = build_pay_to_msg(query_id, recipient, exit::refund, storage::jetton0_wallet, refund_amount0, storage::jetton1_wallet, refund_amount1, storage::fee, storage::tick_spacing);
      send_simple_message(GAS::REFUND, storage::router_address, refund_body.end_cell(), NORMAL);
      remaining_gas -= GAS::REFUND;
    }
    ;; send batch storage::tick
    remaining_gas -=  GAS::CB_ADD_LIQUIDITY;
    (cell state_init, slice position_address) = get_position_state_init_and_address(tick_lower, tick_upper, recipient, my_address(),  storage::position_code);
    builder mint_body = begin_cell()
                          .store_uint(op::mint_position, 32)
                          .store_uint(query_id, 64)
                          .store_int(liquidity_delta, 128)
                          .store_uint(fee_growth_inside_0X128, 256)
                          .store_uint(fee_growth_inside_1X128, 256);
    send_message_with_stateinit(remaining_gas, position_address, state_init, mint_body.end_cell(), 0);
    save_data();
    return ();
  }

  ;; if(op == op::burn){
  ;; }

  ;; if(op == op::cb_burn){

  ;; }

  if(op == op::swap){
    throw_unless(error::unauthorized, compare_address(sender_address, storage::router_address));
    int amount_specified = in_msg_body~load_int(256);
    int zero_for_one = in_msg_body~load_int(2);
    int sqrt_price_limit_x96 = in_msg_body~load_uint(160);
    slice response_address = in_msg_body~load_msg_addr();
    int is_unspl = zero_for_one ? 
    (((sqrt_price_limit_x96 < storage::sqrt_price_x96) & (sqrt_price_limit_x96 > tick_math::MIN_SQRT_RATIO)) == -1)
    : (((sqrt_price_limit_x96 > storage::sqrt_price_x96) & (sqrt_price_limit_x96 < tick_math::MAX_SQRT_RATIO)) == -1);
    ~strdump("is_unspl");
    ~dump(zero_for_one);
    ~dump(sqrt_price_limit_x96);
    ~dump(storage::sqrt_price_x96);
    ~dump(is_unspl);
    int exact_input = amount_specified > 0;
    throw_unless(error::SPL, is_unspl);
    ;; init cache
    int cache::liquidity_start = storage::liquidity; ;; u129
    int cache::fee_protocol = zero_for_one ? (storage::protocol_fee % 16) : (storage::protocol_fee >> 4); ;; u8
    ;; init state
    int state::amount_specified_remaining = amount_specified; ;; i256
    int state::amount_calculated = 0; ;; i256
    int state::sqrt_price_x96 = storage::sqrt_price_x96; ;; u160
    int state::tick = storage::tick; ;;  i24
    int state::fee_growth_global_x128 = zero_for_one ? storage::fee_growth_global_0x128 : storage::fee_growth_global_1x128; ;; u256
    int state::protocol_fee = 0; ;; u128
    int state::liquidity = cache::liquidity_start; ;; u128

    while ((state::amount_specified_remaining > 0) & (state::sqrt_price_x96 != sqrt_price_limit_x96)) {
      ;; init step
      int step::sqrt_price_start_x96 = state::sqrt_price_x96;
      int step::amount_in = 0;
      int step::amount_out = 0;
      int step::fee_amount = 0;
      ;; get next tick 
      (int step::tick_next, int step::initialized) = storage::ticks.tick::next_tick_initialized(state::tick, zero_for_one);

      if(~ step::initialized) {
        if(zero_for_one){
          step::tick_next = tick_math::MAX_TICK;
        } else {
          step::tick_next = tick_math::MIN_TICK;
        }
      }

      ~dump(step::tick_next);
      int step::sqrt_price_next_x96 = tick_math::get_sqrt_ratio_at_tick(step::tick_next);
      int sqrt_target_price = (zero_for_one ? step::sqrt_price_next_x96 < sqrt_price_limit_x96 : step::sqrt_price_next_x96 > sqrt_price_limit_x96) ? sqrt_price_limit_x96 : step::sqrt_price_next_x96;
      ~strdump("step::sqrt_price_next_x96");
      ~dump(state::sqrt_price_x96);
      ~dump(sqrt_target_price);
      ~dump(sqrt_price_limit_x96);
      ~dump(state::liquidity);
      ~dump(state::amount_specified_remaining);
      ~dump(storage::fee);
      
      (state::sqrt_price_x96, step::amount_in, step::amount_out, step::fee_amount) = swap_math::compute_swap_step(state::sqrt_price_x96, sqrt_target_price, state::liquidity, state::amount_specified_remaining, storage::fee);
      ~strdump("step::fee_amount");
      ~dump(step::fee_amount);

      if(exact_input){
        state::amount_specified_remaining -= (step::amount_in + step::fee_amount);
        state::amount_calculated += step::amount_out;
      } else {
        state::amount_specified_remaining += step::amount_out;
        state::amount_calculated = state::amount_calculated + step::amount_in + step::fee_amount;
      }

      if (cache::fee_protocol > 0) {
        int delta = step::fee_amount / cache::fee_protocol;
        step::fee_amount -= delta;
        state::protocol_fee += delta;
      }

      if (state::liquidity > 0) {
        state::fee_growth_global_x128 += full_math::mul_div(step::fee_amount, fixed_point_128::q128, state::liquidity);
      }

      if (state::sqrt_price_x96 == step::sqrt_price_next_x96) {
        if (step::initialized) {
          int cross_fee_growth_global_0_x128 = zero_for_one ? state::fee_growth_global_x128 : storage::fee_growth_global_0x128;
          int cross_fee_growth_global_1_x128 = zero_for_one ? storage::fee_growth_global_1x128 : state::fee_growth_global_x128;
          int liquidity_net = storage::ticks~tick::cross(
            step::tick_next, 
            cross_fee_growth_global_0_x128,
            cross_fee_growth_global_1_x128);
          if (zero_for_one) {
            liquidity_net = 0 - liquidity_net;
          }
          state::liquidity = liquidity_math::add_delta(state::liquidity, liquidity_net);
        }
        state::tick = zero_for_one ? step::tick_next - 1 : step::tick_next;
      }

      if (state::sqrt_price_x96 != step::sqrt_price_start_x96) {
        state::tick = tick_math::get_tick_at_sqrt_ratio(state::sqrt_price_x96);
      }
    }

    if(state::tick != storage::tick){
      storage::sqrt_price_x96 = state::sqrt_price_x96;
      storage::tick = state::tick;
    } else {
      storage::sqrt_price_x96 = state::sqrt_price_x96;
    }

    ;; update liquidity if it changed
    if (cache::liquidity_start != state::liquidity) {
      storage::liquidity = state::liquidity;
    }

    ;; update fee growth global and, if necessary, protocol fees
    ;; overflow is acceptable, protocol has to withdraw before it hits type(uint128).max fees
    if (zero_for_one) {
      storage::fee_growth_global_0x128 = state::fee_growth_global_x128;
      if (state::protocol_fee > 0) {
        storage::collected_protocol_fee0 += state::protocol_fee;
      }
    } else {
      storage::fee_growth_global_1x128 = state::fee_growth_global_x128;
      if (state::protocol_fee > 0) {
        storage::collected_protocol_fee1 += state::protocol_fee;
      }
    }

    (int amount0, int amount1) = zero_for_one == exact_input
            ? (amount_specified - state::amount_specified_remaining, state::amount_calculated)
            : (state::amount_calculated, amount_specified - state::amount_specified_remaining);

    if (zero_for_one){
      if(amount1 < 0) {
          amount1 = 0 - amount1;
        }
      amount0 = amount_specified - amount0; 

      builder msg = build_pay_to_msg(query_id, response_address, exist::finish_swap,storage::jetton0_wallet, amount0, storage::jetton1_wallet, amount1, storage::fee, storage::tick_spacing);

    send_simple_message(0, storage::router_address, msg.end_cell(), CARRY_REMAINING_GAS);
      } else {
      if(amount0 < 0) {
          amount0 = 0 - amount0;
        }
      amount1 = amount_specified - amount1; 
    builder msg = build_pay_to_msg(query_id, response_address, exist::finish_swap,storage::jetton0_wallet, amount0, storage::jetton1_wallet, amount1, storage::fee, storage::tick_spacing);

    send_simple_message(0, storage::router_address, msg.end_cell(), CARRY_REMAINING_GAS);
      }


    save_data();
    return ();
  }

  ;; if (op == op::cb_swap) {
  ;;   slice ds = in_msg_body~load_ref().begin_parse();
  ;;   (
  ;;     int r_batch_index, 
  ;;     int r_tick, 
  ;;     int r_sqrt_price_x96, 
  ;;     int r_liquidity, 
  ;;     int r_storage::storage::fee_growth_global_0x128, 
  ;;     int r_storage::storage::fee_growth_global_1x128, 
  ;;     int r_zero_for_one, 
  ;;     int r_protocol_storage::fee,  
  ;;     int r_amount0, 
  ;;     int r_amount1, 
  ;;     slice response_address
  ;;   ) = unpack_cb_swap(ds);
  ;;   slice batch_tick_address = get_batch_tick_address(r_batch_index, storage::tick_spacing, my_address(), storage::batch_tick_code);
  ;;   throw_unless(error::unauthorized, compare_address(sender_address, batch_tick_address));
  ;;   storage::tick = r_tick;
  ;;   storage::sqrt_price_x96 = r_sqrt_price_x96;
  ;;   storage::liquidity = r_liquidity;
  ;;   storage::storage::fee_growth_global_0x128 = r_storage::storage::fee_growth_global_0x128;
  ;;   storage::storage::fee_growth_global_1x128 = r_storage::storage::fee_growth_global_1x128;
  ;;   if (r_zero_for_one) {
  ;;     collected_protocol_storage::fee0 += r_protocol_storage::fee;
  ;;   } else {
  ;;     collected_protocol_storage::fee1 += r_protocol_storage::fee;
  ;;   }
  ;;   ~dump(op::cb_swap);
  ;;   ~dump(r_amount0);
  ;;   ~dump(r_amount1);
  ;;   builder msg = build_pay_to_msg(query_id, response_address, exist::finish_swap,storage::jetton0_wallet, r_amount0, storage::jetton1_wallet, r_amount1, storage::fee, storage::tick_spacing);
  ;;   send_simple_message(0, storage::router_address, msg.end_cell(), CARRY_REMAINING_GAS);
  ;;   save_data();
  ;;   return ();
  ;; }

  ;; if(op == op::cb_update_storage::fee_growth_inside){
  ;;   slice body = in_msg_body~load_ref().begin_parse();
  ;;   (int batch_tick_index, int liquidity_delta, int tick_lower, int flipped_lower, int tick_upper, int flipped_upper, int storage::fee_growth_inside_0X128, int storage::fee_growth_inside_1X128, slice owner_address) = (body~load_int(16),body~load_uint(128), body~load_int(24), body~load_int(2), body~load_int(24), body~load_int(2), body~load_uint(256), body~load_uint(256), body~load_msg_addr());
  ;;   slice batch_tick_address = get_batch_tick_address(batch_tick_index, storage::tick_spacing, my_address(),storage::batch_tick_code);
  ;;   throw_unless(error::unauthorized, compare_address(sender_address, batch_tick_address));
  ;;   if ((storage::tick >  tick_lower) & (storage::tick < tick_upper)) {
  ;;     storage::liquidity = storage::liquidity.liquidity_math::add_delta(liquidity_delta);
  ;;   }
  ;;   if(flipped_lower){
  ;;     storage::tick_bitmap~storage::tick_bitmap::flip_tick(tick_lower, storage::tick_spacing);
  ;;   }
  ;;   if(flipped_upper){
  ;;     storage::tick_bitmap~storage::tick_bitmap::flip_tick(tick_upper, storage::tick_spacing);
  ;;   }

  ;;   (cell state_init, slice position_address) = get_position_state_init_and_address(tick_lower, tick_upper, owner_address, my_address(),  storage::position_code);

  ;;   builder mint_body = begin_cell()
  ;;                         .store_uint(op::mint_position, 32)
  ;;                         .store_uint(query_id, 64)
  ;;                         .store_int(liquidity_delta, 128)
  ;;                         .store_uint(storage::fee_growth_inside_0X128, 256)
  ;;                         .store_uint(storage::fee_growth_inside_1X128, 256);

  ;;   send_message_with_stateinit(0, position_address, state_init, mint_body.end_cell(), CARRY_REMAINING_GAS);
  ;;   save_data();
  ;;   return();
  ;; }

  if (op == op::cb_mint_position) {
    slice first_ref = in_msg_body~load_ref().begin_parse();
    (int tick_lower, int tick_upper, int liquidity, int fee_growth_inside_0_last_x128, int fee_growth_inside_1_last_x128) = (first_ref~load_int(24), first_ref~load_int(24), first_ref~load_uint(128), first_ref~load_uint(256), first_ref~load_uint(256));
    slice second_ref = in_msg_body~load_ref().begin_parse();
    (int tokens_owed_0, int tokens_owed_1, slice owner_address) = (second_ref~load_uint(128), second_ref~load_uint(128), second_ref~load_msg_addr());
    (cell state_init, slice position_address) = get_position_state_init_and_address(tick_lower, tick_upper, owner_address, my_address(), storage::position_code);
    throw_unless(error::unauthorized, compare_address(sender_address, position_address));
    send_empty_message(0, owner_address, IGNORE_ERRORS + CARRY_REMAINING_GAS);
    builder msg = begin_cell()
                  .store_slice(sender_address)
                  .store_ref(begin_cell()
                      .store_int(tick_lower, 24)
                      .store_int(tick_upper, 24)
                      .store_uint(liquidity, 128)
                      .store_uint(fee_growth_inside_0_last_x128, 256)
                      .store_uint(fee_growth_inside_1_last_x128, 256)
                      .end_cell())
                  .store_ref(begin_cell()
                      .store_uint(tokens_owed_0, 128)
                      .store_uint(tokens_owed_1, 128)
                      .store_slice(owner_address)
                      .end_cell());
    emit_log_simple(0, msg.end_cell(), query_id);
    return ();
  }

  
  throw(0xffff); ;; if the message contains an op that is not known to this contract, we throw
}

(slice, slice) get_jettons_wallet() method_id {
  load_data();
  return (storage::jetton0_wallet, storage::jetton1_wallet);
}

(int, int) get_storage::fees_growth_global() method_id {
  load_data();
  return (storage::fee_growth_global_0x128, storage::fee_growth_global_1x128);
}

(int, int) get_collected_storage::fees() method_id {
  load_data();
  return (storage::collected_protocol_fee0, storage::collected_protocol_fee1);
}

slice get_lp_account_address(slice user_address, int tick_lower, int tick_upper) method_id {
  load_data();
  return calculate_user_lp_account_address(user_address, my_address(), tick_lower, tick_upper, storage::lp_account_code);
}


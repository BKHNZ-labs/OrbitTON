const WORKCHAIN = 0;

(int) get_workchain(slice address) inline {
  (int wc, _) = parse_std_addr(address);
  return wc;
}

() force_chain(int workchain, slice address, int error_code) impure inline {
  (int wc) = get_workchain(address);
  throw_unless(error_code, wc == workchain);
}

(builder) create_simple_transfer_body(int query_id, int fwd_amount, int jetton_amount, slice to) inline {
  return begin_cell()
        .store_uint(0xf8a7ea5, 32)
        .store_uint(query_id, 64)
        .store_coins(jetton_amount)
        .store_slice(to) ;; to_owner_address
        .store_slice(to)
        .store_uint(0, 1)
        .store_coins(fwd_amount) ;; forward_ton_amount
        .store_uint(0, 1);
}

int calculate_min_tons_for_storage(slice address) inline {
  int workchain = get_workchain(address);
    
  ;; Storage fees are different based on workchain:
  ;; Basechain (0): 1 gas = 400 nanotons
  ;; Masterchain (-1): 1 gas = 10000 nanotons
    
  int seconds = 31536000; ;; 1 year
  slice ds = get_data().begin_parse();
  int cells = ds.slice_refs();
  int bits = ds.slice_bits();
    
  int min_storage_fee = get_storage_fee(workchain, seconds, bits, cells);
  return min_storage_fee;
}
global slice storage::router_address; ;; 267
global slice storage::jetton0_wallet; ;; 267
global slice storage::jetton1_wallet; ;; 267
global int storage::fee; ;; 24 - uint
global int storage::protocol_fee; ;; 8 - uint
global int storage::sqrt_price_x96; ;; 160 - uint


global int storage::tick_spacing; ;; 24
global int storage::tick; ;; 24
global int storage::fee_growth_global_0x128; ;; 256 - uint
global int storage::fee_growth_global_1x128; ;; 256 - uint
global int storage::collected_protocol_fee0; ;; 128 - uint
global int storage::collected_protocol_fee1; ;; 128 - uint
global int storage::liquidity; ;; 128 - uint

global int storage::max_liquidity_per_tick; ;; 128 - uint
global cell storage::position_code;
global cell storage::lp_account_code;
global cell storage::ticks;


;; load_data populates storage variables using stored data
() load_data() impure {
  var ds = get_data().begin_parse();
  slice first_cell = ds~load_ref().begin_parse();
  storage::router_address = first_cell~load_msg_addr();
  storage::jetton0_wallet = first_cell~load_msg_addr();
  storage::jetton1_wallet = first_cell~load_msg_addr();
  storage::fee = first_cell~load_uint(24);
  storage::protocol_fee = first_cell~load_uint(8);
  storage::sqrt_price_x96 = first_cell~load_uint(160);
  slice second_cell = ds~load_ref().begin_parse();
  storage::tick_spacing = second_cell~load_int(24);
  storage::tick = second_cell~load_int(24);
  storage::fee_growth_global_0x128 = second_cell~load_uint(256);
  storage::fee_growth_global_1x128 = second_cell~load_uint(256);
  storage::collected_protocol_fee0 = second_cell~load_uint(128);
  storage::collected_protocol_fee1 = second_cell~load_uint(128);
  storage::liquidity = second_cell~load_uint(128);
  slice third_cell = ds~load_ref().begin_parse();
  storage::max_liquidity_per_tick = third_cell~load_uint(128);
  storage::ticks = third_cell~load_dict();
  storage::position_code = third_cell~load_ref();
  storage::lp_account_code = third_cell~load_ref();
  ds.end_parse();
}

;; save_data stores storage variables as a cell into persistent storage
() save_data() impure inline_ref {
  set_data(
    begin_cell()
      .store_ref(
      begin_cell()
          .store_slice(storage::router_address)
          .store_slice(storage::jetton0_wallet)
          .store_slice(storage::jetton1_wallet)
          .store_uint(storage::fee, 24)
          .store_uint(storage::protocol_fee, 8)
          .store_uint(storage::sqrt_price_x96, 160)
          .end_cell())
      .store_ref(
      begin_cell()
          .store_int(storage::tick_spacing, 24)
          .store_int(storage::tick, 24)
          .store_uint(storage::fee_growth_global_0x128, 256)
          .store_uint(storage::fee_growth_global_1x128, 256)
          .store_uint(storage::collected_protocol_fee0, 128)
          .store_uint(storage::collected_protocol_fee1, 128)
          .store_uint(storage::liquidity, 128)
          .end_cell())
      .store_ref(
      begin_cell()
          .store_uint(storage::max_liquidity_per_tick, 128)
          .store_dict(storage::ticks)
          .store_ref(storage::position_code)
          .store_ref(storage::lp_account_code)
          .end_cell())
        .end_cell()
  );
}
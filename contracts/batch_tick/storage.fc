global int storage::batch_index;
global int storage::storage::tick_spacing;
global slice storage::pool_address;
global cell storage::ticks;
global cell storage::storage::batch_tick_code;

;; load_data populates storage variables using stored data
() load_data() impure {
  var ds = get_data().begin_parse();
  storage::batch_index = ds~load_int(16);
  storage::storage::tick_spacing = ds~load_int(24);
  storage::pool_address = ds~load_msg_addr();
  storage::ticks = ds~load_dict();
  storage::storage::batch_tick_code = ds~load_ref();
  ds.end_parse();
}

;; save_data stores storage variables as a cell into persistent storage
() save_data() impure inline_ref {
  set_data(
    begin_cell()
      .store_int(storage::batch_index, 16)
      .store_int(storage::storage::tick_spacing, 24)
      .store_slice(storage::pool_address)
      .store_dict(storage::ticks)
      .store_ref(storage::storage::batch_tick_code)
    .end_cell()
  );
}

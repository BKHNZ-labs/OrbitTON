#include "imports/stdlib.fc";
#include "common/address.fc";
#include "common/messages.fc";
#include "common/utils.fc";
#include "vote/utils.fc";
#include "merkle-tree.fc";
#include "op-codes.fc";

global int proposal_id;
global int start_time;
global int end_time;
global int current_power;
global int threshold_power;
global slice proposal_issuer;
global int root_hash;
global cell proposal_info;
global cell vote_code;

() load_data() impure {
    var ds = get_data().begin_parse();
    slice metadata_cs = ds~load_ref().begin_parse();
    start_time = metadata_cs~load_uint(128);
    end_time = metadata_cs~load_uint(128);
    current_power = metadata_cs~load_uint(256);
    threshold_power = metadata_cs~load_uint(256);

    slice config_cs = ds~load_ref().begin_parse();
    proposal_id = config_cs~load_uint(256);
    root_hash = config_cs~load_uint(256);
    proposal_issuer = config_cs~load_msg_addr();
    proposal_info = config_cs~load_ref();
    vote_code = config_cs~load_ref();
    ds.end_parse();
}

;; save_data stores storage variables as a cell into persistent storage
() save_data() impure inline_ref {
    set_data(
        begin_cell()
            .store_ref(
                begin_cell()
                    .store_uint(start_time, 128)
                    .store_uint(end_time, 128)
                    .store_uint(current_power, 256)
                    .store_uint(threshold_power, 256)
                .end_cell()
            )
            .store_ref(
                begin_cell()
                    .store_uint(proposal_id, 256)
                    .store_uint(root_hash, 256)
                    .store_slice(proposal_issuer)
                    .store_ref(proposal_info)
                    .store_ref(vote_code)
                .end_cell()
            )
        .end_cell()
    );
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) { ;; ignore all empty messages        
    return ();
  }

  slice cs = in_msg_full.begin_parse();
  
  int flags = cs~load_uint(4);

  if (flags & 1) { ;; ignore all bounced messages
      return ();
  }

  ~dump(null());

  load_data(); ;; here we populate the storage variables

  slice sender_address = cs~load_msg_addr();
  int op = in_msg_body~load_uint(32); ;; by convention, the first 32 bits of incoming message is the op
  int query_id = in_msg_body~load_uint(64); ;; also by convention, the next 64 bits contain the "query id", although this is not always the case

  if (op == op::initialize) {
    int proposal_id = in_msg_body~load_uint(256);
    slice ds = in_msg_body~load_ref().begin_parse();
    start_time = ds~load_uint(128);
    end_time = ds~load_uint(128);
    threshold_power = ds~load_uint(256);
    root_hash = ds~load_uint(256);
    proposal_info = ds~load_ref();
    save_data();
    return ();
  }

  if (op == op::vote) {
    throw_unless(101, (now() >= start_time) & (now() <= end_time));
    slice ds = in_msg_body~load_ref().begin_parse();
    int leaf = sender_address.slice_hash();
    int vote = ds~load_int(2);
    slice branch = ds~load_ref().begin_parse();
    slice positions = ds~load_ref().begin_parse();
    int calculate_root_hash = hash_from_tree_proof_ref(branch, leaf, positions);
    throw_unless(400, calculate_root_hash == root_hash);
    (cell state_init, slice vote_address) = get_vote_state_init_and_address(my_address(), sender_address, vote_code);
    cell msg = begin_cell()
      .store_uint(op::init_vote, 32)
      .store_uint(query_id, 64)
      .store_int(vote, 2)
      .end_cell();
    send_message_with_stateinit(0, vote_address, state_init, msg, CARRY_REMAINING_GAS);
    save_data();
    return ();
  }

  if (op == op::cb_vote) {
    slice ds = in_msg_body;
    int vote = ds~load_int(2);
    slice vote_owner = ds~load_msg_addr();
    (cell state_init, slice vote_address) = get_vote_state_init_and_address(my_address(), vote_owner, vote_code);
    throw_unless(401, compare_address(sender_address, vote_address));
    current_power = current_power + vote;
    if (current_power >= threshold_power) {
      ;; do other things here
      ;; may be execute code, update state, etc. storage should be modified a little, this is for demo only
    }
    save_data();
    return ();
  }
}

(int) get_vote_power() method_id {
  load_data();
  return current_power;
}